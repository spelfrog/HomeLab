# Caddyfile for core2 (192.168.2.14). Deployed to /var/config/caddy/Caddyfile
{
	# Certificates come from lego, Caddy must not try ACME itself
	auto_https disable_certs
	servers {
		# No HTTP/3: the FritzBox does not forward UDP 443
		protocols h1 h2
		timeouts {
			read_header 10s
			read_body 30s
			idle 2m
		}
	}
}

(cert) {
	tls /certs/reihungen.de.crt /certs/reihungen.de.key
}

# Everything except www.lügen.eu is reachable from the home network only.
# The FritzBox forwards 80/443 without proxying, so the client IP is real.
(lan_only) {
	@wan not remote_ip private_ranges
	abort @wan
}

# Hub page listing this host's services (static files from /var/config/caddy/site)
core2.reihungen.de {
	import lan_only
	import cert
	root * /srv
	file_server
	header Cache-Control "no-cache"
}

jellyfin.reihungen.de {
	import lan_only
	import cert
	reverse_proxy localhost:8096
}

jellyseerr.reihungen.de {
	import lan_only
	import cert
	reverse_proxy localhost:5055
}

radarr.reihungen.de {
	import lan_only
	import cert
	reverse_proxy localhost:7878
}

sonarr.reihungen.de {
	import lan_only
	import cert
	reverse_proxy localhost:8989
}

prowlarr.reihungen.de {
	import lan_only
	import cert
	reverse_proxy localhost:9696
}

sabnzbd.reihungen.de {
	import lan_only
	import cert
	reverse_proxy localhost:8080
}

# www.lügen.eu (punycode), certificate is in the same lego wildcard cert.
# The only public site, so it gets an access log, body limit, security headers
# and path restrictions.
www.xn--lgen-0ra.eu {
	import cert
	log {
		output file /data/access-luegen.log {
			roll_size 10mb
			roll_keep 5
		}
	}
	request_body {
		max_size 256KB
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		# Page loads a Google Font stylesheet; scripts/styles are /static/*, no inline code
		Content-Security-Policy "default-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:"
		-Server
	}
	# Telegram webhook: only from Telegram's published webhook ranges
	@tg_bad path /webhook/* not remote_ip 149.154.160.0/20 91.108.4.0/22
	abort @tg_bad
	# Health check: home network only
	@health_wan path /healthz not remote_ip private_ranges
	abort @health_wan
	reverse_proxy localhost:8004
}

xn--lgen-0ra.eu {
	import cert
	redir https://www.xn--lgen-0ra.eu{uri} permanent
}

# Catch-all for unknown hostnames hitting 443 (otherwise Caddy answers an empty 200)
https:// {
	import cert
	abort
}
