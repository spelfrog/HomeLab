# Caddyfile for core1 (192.168.2.13). Deployed to /var/config/caddy/Caddyfile
{
	# Certificates come from lego, Caddy must not try ACME itself
	auto_https disable_certs
}

(cert) {
	tls /certs/reihungen.de.crt /certs/reihungen.de.key
}

home.reihungen.de {
	import cert
	reverse_proxy localhost:8123
}

paperless.reihungen.de {
	import cert
	reverse_proxy localhost:8000
}

photos.reihungen.de {
	import cert
	reverse_proxy localhost:2342
}

pihole.reihungen.de {
	import cert
	redir / /admin/
	reverse_proxy localhost:8888
}

spoolman.reihungen.de {
	import cert
	reverse_proxy localhost:7912
}
