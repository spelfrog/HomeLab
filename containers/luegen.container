# Rootless user quadlet. Belongs in ~luegen/.config/containers/systemd/ (see README "luegen").
[Unit]
Description=lügen.eu Container (website + Telegram bot)
After=network-online.target
Wants=network-online.target

[Container]
# Built from https://git-ce.rwth-aachen.de/raphael/luegen.eu (buildAndPush.sh)
Image=registry.git-ce.rwth-aachen.de/raphael/luegen.eu:latest
ContainerName=luegen
AutoUpdate=registry

# The image runs as uid 1000; map it to the rootless user so /data is writable
UserNS=keep-id:uid=1000,gid=1000

# Least privilege: no capabilities, read-only image, process limit
DropCapability=all
NoNewPrivileges=true
ReadOnly=true
PodmanArgs=--pids-limit 200

Environment=TZ=Europe/Berlin
Environment=WEBSITE_URL=https://www.xn--lgen-0ra.eu/
# Telegram user ids allowed to manage lies
Environment=ADMIN_IDS=447941998,610185013
Secret=luegen_bot_token,type=env,target=BOT_TOKEN
Secret=luegen_webhook_token,type=env,target=WEBHOOK_TOKEN

# SQLite database (Lies.sqlite)
Volume=%h/data:/data:Z

# Only on loopback, published as www.lügen.eu by caddy (host network)
PublishPort=127.0.0.1:8004:8000/tcp

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=default.target
