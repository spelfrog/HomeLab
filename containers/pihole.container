[Install]
WantedBy=default.target

[Container]
Image=docker.io/pihole/pihole
AutoUpdate=registry
Volume=/var/lib/pihole/pihole:/etc/pihole:z
Volume=/var/lib/pihole/dnsmasq:/etc/dnsmasq.d:z
PublishPort=192.168.2.13:53:53/tcp
PublishPort=192.168.2.13:53:53/udp
Secret=pihole_password,type=env,target=WEBPASSWORD

[Service]
Restart=always