[Unit]
Description=AdGuard Home Container (DNS filter, replaces pihole)
After=local-fs.target network-online.target
Wants=network-online.target
# Both bind 192.168.2.13:53, never run them together
Conflicts=pihole.service

[Container]
Image=docker.io/adguard/adguardhome:latest
ContainerName=adguard
AutoUpdate=registry

# Least privilege: only binding 53/80 is needed (no DHCP, so no NET_RAW)
DropCapability=all
AddCapability=NET_BIND_SERVICE
NoNewPrivileges=true

Environment=TZ=Europe/Berlin

# AdGuardHome.yaml from the repo, deployed to /var/config/adguard/ (AdGuard rewrites it on start)
Volume=/var/config/adguard:/opt/adguardhome/conf:Z
# Query log, statistics, filter cache
Volume=/var/lib/adguard:/opt/adguardhome/work:Z

PublishPort=192.168.2.13:53:53/tcp
PublishPort=192.168.2.13:53:53/udp
# Web UI only on loopback, published as adguard.reihungen.de by caddy (same port pihole used)
PublishPort=127.0.0.1:8888:80/tcp

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target default.target
